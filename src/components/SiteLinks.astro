---
// Liens du site (Flight Planner, Contact, Portal), dans l'en-tête et dans le menu mobile.
const fr = Astro.locals.starlightRoute.locale === 'fr';
const site = fr ? 'https://helix.aero/fr' : 'https://helix.aero/en';
---

<nav class="hx-nav" aria-label={fr ? 'Liens du site' : 'Site links'}>
  <a href={`${site}/flight-planner`}>Flight Planner</a>
  <a href={`${site}/contact`}>Contact</a>
  <a class="hx-pill" href="https://app.helix.aero" target="_blank" rel="noopener">Portal <span aria-hidden="true">↗</span></a>
  <slot />
</nav>

<style>
  .hx-nav { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; font-family: var(--hx-font-head); font-size: 0.875rem; }
  .hx-nav a { color: var(--hx-ink); text-decoration: none; white-space: nowrap; }
  .hx-nav a:hover { color: var(--hx-green-text); }
  .hx-pill { border: 1px solid rgb(17 18 20 / 0.14); border-radius: 999px; padding: 0.4rem 1rem; font-weight: 500; }
  .hx-pill:hover { border-color: var(--hx-ink); }
</style>
