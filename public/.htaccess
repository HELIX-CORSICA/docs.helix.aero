# docs.helix.aero chez o2switch (site statique Astro) : page 404 du site, ressources en cache ; redirections ajoutées au build (astro.config.mjs).
# Ce fichier se termine par un saut de ligne : le build y ajoute les règles de redirection.
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
